# Discord Bot Token (from discord.dev)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Anthropic API key (required for /translate and the translate MCP tool)
ANTHROPIC_API_KEY=
ANTHROPIC_TRANSLATE_MODEL=claude-3-5-haiku-latest

# Voice plugin (optional — only needed if voice plugin enabled)
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_JA=

# Free brain (optional — plugins/free, see docs/free-brain.md "Getting keys")
# Any provider left empty is skipped. A second key you own: GROQ_API_KEY_2=, _3=, …
# GROQ_API_KEY above is shared with the voice plugin.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Prototyping-only terms; see docs/free-brain.md before enabling for other people
NVIDIA_API_KEY=

#!/usr/bin/env bash
# Choomfie launcher.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/.." && pwd)"

if [ ! -d "$ROOT_DIR/node_modules" ]; then
  echo "Installing dependencies..."
  (cd "$ROOT_DIR" && bun install --no-summary)
fi

USE_TMUX=false
USE_DAEMON=false
ALWAYS_ON=false
EXTRA_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --tmux) USE_TMUX=true ;;
    --daemon) USE_DAEMON=true ;;
    --always-on) ALWAYS_ON=true; USE_TMUX=true ;;
    *) EXTRA_ARGS+=("$arg") ;;
  esac
done

# --- Refuse to fight a running daemon ---
# supervisor.ts makes this same check, but it runs underneath the claude CLI,
# so its message lands in MCP logs rather than your terminal. Checking here
# means you see it. Skipped for --daemon: the daemon's own PID guard
# deliberately takes over from a previous daemon, which is what you asked for.
if [ "$USE_DAEMON" = false ]; then
  # Must match resolveDataDir() in packages/shared/paths.ts.
  DATA_DIR="${CHOOMFIE_DATA_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/choomfie-inline}}"
  DAEMON_PID_FILE="$DATA_DIR/meta/meta.pid"

  if [ -f "$DAEMON_PID_FILE" ]; then
    DAEMON_PID="$(tr -d '[:space:]' < "$DAEMON_PID_FILE" 2>/dev/null || true)"
    if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
      DAEMON_CMD="$(ps -p "$DAEMON_PID" -o command= 2>/dev/null || true)"
      # Match the daemon entry point only, never "choomfie" — the repo and data
      # dir are both named that, so any command line mentioning a path under
      # them would match a recycled PID. Keep in sync with
      # CHOOMFIE_DAEMON_MARKER in packages/shared/pid-utils.ts.
      case "$DAEMON_CMD" in
        *daemon.ts*)
          echo "Choomfie is already running as a daemon (PID $DAEMON_PID)."
          echo "Starting another instance would fight it for the Discord connection."
          echo ""
          echo "Stop the daemon first:"
          echo "  bun packages/core/daemon.ts --stop"
          echo "Or, if it was installed to run at login:"
          echo "  bun run install:launchd --uninstall"
          exit 1
          ;;
      esac
    fi
  fi
fi

if [ "$USE_DAEMON" = true ]; then
  QUOTED_ARGS=""
  for a in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
    QUOTED_ARGS="$QUOTED_ARGS $(printf %q "$a")"
  done
  INNER_CMD="cd $(printf %q "$ROOT_DIR") && exec bun packages/core/daemon.ts$QUOTED_ARGS"
else
  INNER_CMD="cd $(printf %q "$ROOT_DIR") && exec claude --plugin-dir $(printf %q "$ROOT_DIR") --dangerously-load-development-channels server:choomfie"
fi

if [ "$USE_TMUX" = true ]; then
  if ! command -v tmux >/dev/null 2>&1; then
    echo "Error: tmux not found."
    exit 1
  fi

  if [ "$ALWAYS_ON" = true ] && command -v caffeinate >/dev/null 2>&1; then
    pkill -f "caffeinate.*choomfie" 2>/dev/null || true
    caffeinate -dims &
    CAFFEINATE_PID=$!
    trap "kill $CAFFEINATE_PID 2>/dev/null" EXIT
  fi

  SESSION_NAME="choomfie-claude-code"
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    tmux attach -t "$SESSION_NAME"
  else
    tmux new-session -d -s "$SESSION_NAME" "$INNER_CMD"
    tmux attach -t "$SESSION_NAME"
  fi
else
  cd "$ROOT_DIR"
  if [ "$USE_DAEMON" = true ]; then
    exec bun packages/core/daemon.ts "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
  fi
  exec claude --plugin-dir "$ROOT_DIR" --dangerously-load-development-channels server:choomfie
fi
